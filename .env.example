# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID="your_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_PROJECT_ID="your_project_id"
SANITY_DATASET="production"

# Sanity API token for private dataset reads and write operations.
# Generate at: https://www.sanity.io/manage/project/your_project_id/api#tokens
SANITY_API_TOKEN="your_sanity_api_token"

# Clerk Authentication
# Get keys from: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxx"
CLERK_SECRET_KEY="sk_test_xxxxx"

# Neon Postgres
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# External scheduler authentication. Configure cron-job.org to call
# /api/cron/sync-notifications with: Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="your_cron_secret"

# Conference sync. Set CONFERENCE_RSS_URL to one or more comma-separated RSS
# feeds, or set EASYCHAIR_CFP_SOURCE_URL to an EasyChair CFP listing page.
CONFERENCE_RSS_URL=""
EASYCHAIR_CFP_SOURCE_URL="https://easychair.org/cfp/"
# Number of EasyChair detail pages to process per scheduler run.
EASYCHAIR_SYNC_DETAILS_LIMIT="25"

# Razorpay
RAZORPAY_KEY_ID="rzp_test_xxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxx"

# Secret used to HMAC-sign short-lived PDF viewer URLs.
# Optional: falls back to RAZORPAY_KEY_SECRET if unset, but set a dedicated
# value in production. Generate one with: openssl rand -base64 32
PDF_SIGNING_SECRET="your_long_random_secret"


# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
