generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Unified Purchase model for tracking all course, note, and study material purchases.
model Purchase {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  courseSlug  String?  // Sanity slug.current used in /reader/[courseSlug]
  courseName  String
  examType    String?  // UGC NET, UPSC, SSC, etc.
  packageId   String?
  packageName String?
  amount      Int
  paymentId   String?  @unique
  orderId     String   @unique
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([courseSlug])
  @@index([userId, courseSlug])
  @@index([orderId])
}

model AccessLog {
  id         String   @id @default(cuid())
  userId     String?
  purchaseId String?
  slug       String?
  packageId  String?
  index      Int?
  ip         String?
  userAgent  String?
  outcome    String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([purchaseId])
  @@index([createdAt])
}

model Notification {
  id                   String   @id @default(cuid())
  externalId           String   @unique
  type                 String
  title                String
  excerpt              String?
  link                 String?
  source               String
  publishedAt          DateTime?
  isNew                Boolean  @default(true)
  acronym              String?
  fullName             String?
  location             String?
  submissionDeadline   DateTime?
  notificationDate     DateTime?
  cameraReadyDate      DateTime?
  startDate            DateTime?
  endDate              DateTime?
  topics               String[] @default([])
  cfpLink              String?
  conferenceWebPage    String?
  submissionLink       String?
  description          String?
  submissionGuidelines String?
  importantDates       Json?
  topicSections        Json?
  committees           Json?
  publication          String?
  venue                String?
  contactEmail         String?
  lastUpdated          DateTime @default(now()) @updatedAt
  lastDetailFetch      DateTime?

  @@index([type, publishedAt])
  @@index([type, isNew])
  @@index([acronym])
  @@index([submissionDeadline])
}
