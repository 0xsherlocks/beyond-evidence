generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Purchase {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  courseName  String
  packageId   String
  packageName String
  amount      Int
  paymentId   String?  @unique
  orderId     String   @unique
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model AccessLog {
  id         String   @id @default(cuid())
  userId     String?
  purchaseId String?
  slug       String?
  packageId  String?
  index      Int?
  ip         String?
  userAgent  String?
  outcome    String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([purchaseId])
  @@index([createdAt])
}

/// Tracks which Sanity premiumCourse documents a user has paid for.
/// courseSlug is the premiumCourse slug.current value used in /reader/[courseSlug].
model PremiumPurchase {
  id           String   @id @default(cuid())
  userId       String
  courseId     String   // Sanity _id
  courseSlug   String   // sanity slug.current → matches /reader/[courseSlug]
  courseName   String
  examType     String
  amount       Int
  paymentId    String?  @unique
  orderId      String   @unique
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([courseSlug])
  @@index([userId, courseSlug])
}
