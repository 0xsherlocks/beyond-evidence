generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Unified Purchase model for tracking all course, note, and study material purchases.
model Purchase {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  courseSlug  String?  // Sanity slug.current used in /reader/[courseSlug]
  courseName  String
  examType    String?  // UGC NET, UPSC, SSC, etc.
  packageId   String?
  packageName String?
  amount      Int
  paymentId   String?  @unique
  orderId     String   @unique
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([courseSlug])
  @@index([userId, courseSlug])
  @@index([orderId])
}

model AccessLog {
  id         String   @id @default(cuid())
  userId     String?
  purchaseId String?
  slug       String?
  packageId  String?
  index      Int?
  ip         String?
  userAgent  String?
  outcome    String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([purchaseId])
  @@index([createdAt])
}
